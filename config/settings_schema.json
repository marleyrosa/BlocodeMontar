[
  {
    "name": "theme_info",
    "theme_name": "BlocodeMontar",
    "theme_version": "1.0.0",
    "theme_author": "BlocodeMontar",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Identidade da marca",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logotipo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Largura do logotipo",
        "default": 160
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Imagem quadrada, 32 x 32 px"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "poppins_n4",
        "label": "Fonte do texto"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "poppins_n7",
        "label": "Fonte dos títulos"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Fundo"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1B1F3B",
        "label": "Texto"
      },
      {
        "type": "color",
        "id": "primary_color",
        "default": "#FFC20E",
        "label": "Cor principal (destaques e topo)"
      },
      {
        "type": "color",
        "id": "primary_text_color",
        "default": "#1B1F3B",
        "label": "Texto sobre a cor principal"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#E4002B",
        "label": "Cor de destaque (selos de desconto)"
      },
      {
        "type": "color",
        "id": "button_color",
        "default": "#1B1F3B",
        "label": "Botões"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "default": "#FFFFFF",
        "label": "Texto dos botões"
      },
      {
        "type": "color",
        "id": "pix_color",
        "default": "#0E9F6E",
        "label": "Preço no Pix"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F4F5F9",
        "label": "Fundo dos cartões"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Arredondamento dos cantos",
        "default": 10
      }
    ]
  },
  {
    "name": "Condições comerciais",
    "settings": [
      {
        "type": "range",
        "id": "pix_discount",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "%",
        "label": "Desconto no Pix",
        "default": 10,
        "info": "Só exibe o preço na vitrine. Configure o desconto real no seu gateway de pagamento."
      },
      {
        "type": "range",
        "id": "installments",
        "min": 1,
        "max": 12,
        "step": 1,
        "label": "Parcelas sem juros",
        "default": 6
      }
    ]
  },
  {
    "name": "Atendimento e empresa",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp (só números, com DDI e DDD)",
        "info": "Exemplo: 5511999999999"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Mensagem padrão do WhatsApp",
        "default": "Olá! Vim pelo site da BlocodeMontar e tenho uma dúvida."
      },
      {
        "type": "checkbox",
        "id": "whatsapp_float",
        "label": "Mostrar botão flutuante do WhatsApp",
        "default": true
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "E-mail de atendimento"
      },
      {
        "type": "text",
        "id": "support_hours",
        "label": "Horário de atendimento",
        "default": "Segunda a sexta, das 9h às 18h"
      },
      {
        "type": "text",
        "id": "company_name",
        "label": "Razão social"
      },
      {
        "type": "text",
        "id": "company_cnpj",
        "label": "CNPJ"
      }
    ]
  },
  {
    "name": "Redes sociais",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_threads",
        "label": "Threads"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  }
]
