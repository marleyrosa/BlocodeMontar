<div class="help-cards section-spacing">
  {%- if section.settings.title != blank -%}
    <h2 class="help-cards__title">{{ section.settings.title }}</h2>
  {%- endif -%}
  <div class="help-cards__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign url = block.settings.link
        if block.settings.icon == 'whatsapp' and settings.whatsapp_number != blank
          assign number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
          assign encoded_message = settings.whatsapp_message | url_encode
          assign url = 'https://wa.me/' | append: number | append: '?text=' | append: encoded_message
        endif
      -%}
      <a
        href="{{ url | default: '#' }}"
        class="help-card"
        {% if url contains 'wa.me' %}target="_blank" rel="noopener"{% endif %}
        {{ block.shopify_attributes }}
      >
        <span class="help-card__icon">{% render 'icon', name: block.settings.icon %}</span>
        <span>
          <strong>{{ block.settings.heading }}</strong>
          <small>{{ block.settings.text }}</small>
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .help-cards__title {
    margin-bottom: 1rem;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    text-align: center;
  }

  .help-cards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .help-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: transform 0.2s;
  }

  .help-card:hover {
    transform: translateY(-2px);
  }

  .help-card__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-text);
  }

  .help-card__icon .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .help-card strong,
  .help-card small {
    display: block;
  }

  .help-card small {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Como podemos ajudar",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Como podemos ajudar?"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Cartão",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "whatsapp",
          "info": "Com o ícone WhatsApp, o link abre a conversa com o número das configurações do tema.",
          "options": [
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "truck", "label": "Rastreio" },
            { "value": "star", "label": "Mais vendidos" },
            { "value": "gift", "label": "Presente" },
            { "value": "shield", "label": "Garantia" },
            { "value": "package", "label": "Pacote" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Título", "default": "Fale com a gente" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Atendimento pelo WhatsApp" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Como podemos ajudar",
      "blocks": [
        { "type": "card", "settings": { "icon": "whatsapp", "heading": "Fale com a gente", "text": "Tire suas dúvidas pelo WhatsApp" } },
        { "type": "card", "settings": { "icon": "truck", "heading": "Rastrear pedido", "text": "Veja onde está sua entrega", "link": "/pages/rastrear-pedido" } },
        { "type": "card", "settings": { "icon": "star", "heading": "Mais vendidos", "text": "Os favoritos dos colecionadores", "link": "/collections/mais-vendidos" } }
      ]
    }
  ]
}
{% endschema %}
