{%- assign track_id = 'Videos-' | append: section.id -%}
<div class="video-products section-spacing">
  <div class="section-heading">
    <h2>{{ section.settings.title }}</h2>
    <div class="carousel-controls">
      <button type="button" data-carousel-prev data-carousel-target="{{ track_id }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button type="button" data-carousel-next data-carousel-target="{{ track_id }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </div>
  <div class="carousel" id="{{ track_id }}" style="--carousel-item: calc((100% - 4 * 1rem) / 5); --carousel-item-mobile: 60%;">
    {%- for block in section.blocks -%}
      {%- assign video_product = block.settings.product -%}
      <div class="video-card" {{ block.shopify_attributes }}>
        <div class="video-card__media">
          {%- if block.settings.video -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '600x' }}
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if video_product != blank -%}
          <a href="{{ video_product.url }}" class="video-card__info">
            <strong>{{ video_product.title | escape }}</strong>
            {% render 'price', product: video_product, size: 'small' %}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .video-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .video-card__media {
    aspect-ratio: 9 / 16;
    background: var(--color-surface);
  }

  .video-card__media video,
  .video-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-card__info {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem;
    font-size: 0.85rem;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vídeos de produtos",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Veja montado" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vídeo",
      "settings": [
        { "type": "video", "id": "video", "label": "Vídeo (vertical)" },
        { "type": "product", "id": "product", "label": "Produto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vídeos de produtos",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
