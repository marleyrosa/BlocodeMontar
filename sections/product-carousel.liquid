{%- liquid
  assign track_id = 'Products-' | append: section.id
  assign source = section.settings.collection
-%}
<div class="product-carousel section-spacing">
  <div class="section-heading">
    <h2>{{ section.settings.title | default: source.title }}</h2>
    <div class="product-carousel__actions">
      {%- if source != blank and section.settings.show_view_all -%}
        <a href="{{ source.url }}">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
      <div class="carousel-controls">
        <button type="button" data-carousel-prev data-carousel-target="{{ track_id }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" data-carousel-next data-carousel-target="{{ track_id }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
  </div>

  <div class="carousel" id="{{ track_id }}">
    {%- if source != blank and source.products_count > 0 -%}
      {%- for product in source.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card product-card--empty">
          <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}</div>
          <div class="product-card__content"><p>{{ 'products.empty_collection' | t }}</p></div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-carousel__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product-card--empty p {
    font-size: 0.85rem;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Carrossel de produtos",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Mais vendidos" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "limit", "label": "Quantidade de produtos", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar link \"Ver todos\"", "default": true }
  ],
  "presets": [
    { "name": "Carrossel de produtos" }
  ]
}
{% endschema %}
