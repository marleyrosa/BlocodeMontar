{%- assign track_id = 'Tiles-' | append: section.id -%}
<div class="collection-tiles section-spacing">
  <div class="section-heading">
    <h2>{{ section.settings.title }}</h2>
    <div class="carousel-controls">
      <button type="button" data-carousel-prev data-carousel-target="{{ track_id }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button type="button" data-carousel-next data-carousel-target="{{ track_id }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </div>

  <div class="carousel" id="{{ track_id }}" style="--carousel-item: calc((100% - 5 * 1rem) / 6); --carousel-item-tablet: calc((100% - 3 * 1rem) / 4); --carousel-item-mobile: 38%;">
    {%- for block in section.blocks -%}
      {%- assign tile_collection = block.settings.collection -%}
      {%- assign tile_image = block.settings.image | default: tile_collection.featured_image -%}
      <a href="{{ tile_collection.url | default: '#' }}" class="collection-tile" {{ block.shopify_attributes }}>
        <span class="collection-tile__media">
          {%- if tile_image -%}
            {{ tile_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 990px) 16vw, 38vw' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </span>
        <span class="collection-tile__title">{{ block.settings.title | default: tile_collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .collection-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .collection-tile__media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-surface);
    border: 3px solid var(--color-primary);
  }

  .collection-tile__media img,
  .collection-tile__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-tile__title {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Categorias em destaque",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Navegue por categoria" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional)", "info": "Sem imagem, usa a imagem da coleção." },
        { "type": "text", "id": "title", "label": "Nome (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias em destaque",
      "blocks": [
        { "type": "tile", "settings": { "title": "Fórmula 1" } },
        { "type": "tile", "settings": { "title": "Filmes e heróis" } },
        { "type": "tile", "settings": { "title": "Veículos" } },
        { "type": "tile", "settings": { "title": "Arquitetura" } },
        { "type": "tile", "settings": { "title": "Espacial" } },
        { "type": "tile", "settings": { "title": "Botânica" } }
      ]
    }
  ]
}
{% endschema %}
