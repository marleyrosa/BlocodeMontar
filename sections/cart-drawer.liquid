{% comment %}
  Side cart that opens when a product is added, so the customer stays on the
  page. Rendered once in the layout and refreshed through the Section
  Rendering API by assets/cart-drawer.js.
{% endcomment %}

{%- liquid
  assign pix_factor = 100 | minus: settings.pix_discount
  assign pix_total = cart.total_price | times: pix_factor | divided_by: 100
  assign installments = settings.installments | at_least: 1
  assign installment_total = cart.total_price | divided_by: installments | money
-%}

<div class="cart-drawer" data-cart-drawer data-count="{{ cart.item_count }}" hidden>
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <aside
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
  >
    <header class="cart-drawer__header">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">
        {{ 'cart.title' | t }}
        <span class="cart-drawer__count">({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'header.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </header>

    <p class="cart-drawer__added" data-cart-drawer-added hidden>{{ 'cart.added' | t }}</p>

    {%- if cart.item_count > 0 -%}
      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          <li class="cart-drawer__item">
            <a href="{{ item.url }}" class="cart-drawer__image">
              {%- if item.image -%}
                {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}
              {%- endif -%}
            </a>
            <div class="cart-drawer__info">
              <a href="{{ item.url }}" class="cart-drawer__name">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <small>{{ item.variant.title }}</small>
              {%- endunless -%}
              <div class="cart-drawer__row">
                <div class="cart-drawer__qty">
                  <button
                    type="button"
                    data-cart-change="{{ item.key }}"
                    data-quantity="{{ item.quantity | minus: 1 }}"
                    aria-label="-1"
                  >
                    &minus;
                  </button>
                  <span aria-live="polite">{{ item.quantity }}</span>
                  <button
                    type="button"
                    data-cart-change="{{ item.key }}"
                    data-quantity="{{ item.quantity | plus: 1 }}"
                    aria-label="+1"
                  >
                    +
                  </button>
                </div>
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
              <button type="button" class="cart-drawer__remove" data-cart-change="{{ item.key }}" data-quantity="0">
                {{ 'cart.remove' | t }}
              </button>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <footer class="cart-drawer__footer">
        <div class="cart-drawer__total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        {%- if settings.pix_discount > 0 -%}
          <div class="cart-drawer__total cart-drawer__total--pix">
            <span>{{ 'cart.pix_total' | t: discount: settings.pix_discount }}</span>
            <strong>{{ pix_total | money }}</strong>
          </div>
        {%- endif -%}
        {%- if installments > 1 -%}
          <p class="cart-drawer__note">
            {{ 'products.price.installments_html' | t: count: installments, amount: installment_total }}
          </p>
        {%- endif -%}
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--primary button--full">
            {{ 'cart.checkout' | t }}
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="cart-drawer__link">{{ 'cart.view' | t }}</a>
      </footer>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <button type="button" class="button button--primary" data-cart-drawer-close>{{ 'cart.continue' | t }}</button>
      </div>
    {%- endif -%}
  </aside>
</div>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .cart-drawer[hidden] {
    display: none;
  }

  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.45);
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    width: min(26rem, 100%);
    height: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: -4px 0 24px rgb(0 0 0 / 0.15);
    animation: cart-drawer-in 0.25s ease-out;
  }

  @keyframes cart-drawer-in {
    from {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__panel {
      animation: none;
    }
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__title {
    margin: 0;
    font-size: 1.15rem;
  }

  .cart-drawer__count {
    color: var(--color-foreground-muted);
    font-weight: normal;
  }

  .cart-drawer__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .cart-drawer__added {
    margin: 0;
    padding: 0.6rem 1.25rem;
    background: var(--color-surface);
    color: var(--color-pix);
    font-weight: 600;
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    margin: 0;
    padding: 0 1.25rem;
    list-style: none;
  }

  .cart-drawer__item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.9rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__image {
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
  }

  .cart-drawer__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .cart-drawer__name {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .cart-drawer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cart-drawer__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .cart-drawer__qty button {
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .cart-drawer__qty span {
    min-width: 1.75rem;
    text-align: center;
  }

  .cart-drawer__remove {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground-muted);
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .cart-drawer__footer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 1.25rem 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .cart-drawer__total {
    display: flex;
    justify-content: space-between;
  }

  .cart-drawer__total--pix {
    color: var(--color-pix);
  }

  .cart-drawer__note {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.9rem;
  }

  .cart-drawer__link {
    color: inherit;
    text-align: center;
  }

  .cart-drawer__empty {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;
  }

  .cart-drawer.is-busy .cart-drawer__panel {
    opacity: 0.6;
    pointer-events: none;
  }

  body.cart-drawer-open {
    overflow: hidden;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Carrinho lateral",
  "settings": []
}
{% endschema %}
