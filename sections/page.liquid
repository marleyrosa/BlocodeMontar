{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page section-spacing">
  <h1>{{ page.title }}</h1>
  <div class="page__content">{{ page.content }}</div>
</div>

{% stylesheet %}
  .page {
    max-width: 50rem;
    margin-inline: auto;
  }

  .page h1 {
    margin-bottom: 1.5rem;
  }

  .page__content {
    line-height: 1.7;
  }

  .page__content > * + * {
    margin-top: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
