{% doc %}
  Renders an inline SVG icon.

  @param {string} name - Icon name: whatsapp, truck, search, menu, close, chevron-left, chevron-right, chevron-down, bricks, ruler, scale, star, shield, package, gift, cart, account, pix, card, refresh, instagram, tiktok, threads, facebook, youtube, mail, clock
  @param {string} [class] - Extra CSS class

  @example
  {% render 'icon', name: 'whatsapp' %}
{% enddoc %}

{%- capture attrs -%}
  class="icon icon--{{ name }} {{ class }}" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
{%- endcapture -%}
{%- capture stroke -%}
  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
{%- endcapture -%}

