{% doc %}
  Renders the floating WhatsApp button. On a product page the message
  includes the product name, the SKU and the page link.

  @example
  {% render 'whatsapp-float' %}
{% enddoc %}

{%- if settings.whatsapp_float and settings.whatsapp_number != blank -%}
  {%- liquid
    assign number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
    assign message = settings.whatsapp_message
    if request.page_type == 'product'
      assign sku = product.selected_or_first_available_variant.sku | default: '-'
      assign product_url = request.origin | append: product.url
      assign message = 'products.whatsapp_message' | t: title: product.title, sku: sku, url: product_url
    endif
  -%}
  <a
    href="https://wa.me/{{ number }}?text={{ message | url_encode }}"
    class="whatsapp-float"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'general.whatsapp_contact' | t }}"
  >
    {% render 'icon', name: 'whatsapp' %}
  </a>
{%- endif -%}

{% stylesheet %}
  .whatsapp-float {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }

  .whatsapp-float .icon {
    width: 2rem;
    height: 2rem;
  }
{% endstylesheet %}
